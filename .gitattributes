# Normalizar finales de linea: el fuente original venia en CRLF (DOS).
# Para el port nativo trabajamos en LF dentro del repositorio.
* text=auto eol=lf

# Codigo y textos: forzar LF
*.pas  text eol=lf
*.inc  text eol=lf
*.pp   text eol=lf
*.txt  text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf
*.md   text eol=lf
*.sh   text eol=lf

# Binarios: que git no los toque
*.obj  binary
*.bgi  binary
*.chr  binary
*.hlp  binary
*.fnt  binary
*.rzg  binary
*.dat  binary
# VPA.MSG son plantillas de texto: el port FPC/Linux necesita LF
# (un CRLF deja un CR colgante que RTrim no elimina y corrompe el parseo)
*.msg  text eol=lf
*.zip  binary
