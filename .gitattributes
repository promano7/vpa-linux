# Normalizar finales de linea: el fuente original venia en CRLF (DOS).
# Para el port nativo trabajamos en LF dentro del repositorio.
* text=auto eol=lf

# Codigo y textos: forzar LF
*.pas  text eol=lf
*.inc  text eol=lf
*.pp   text eol=lf
*.txt  text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf
*.md   text eol=lf
*.sh   text eol=lf

# Binarios: que git no los toque
# Los patrones distinguen mayusculas y los ficheros heredados de DOS estan en
# mayusculas, asi que hace falta la variante de cada extension: sin ella estos
# binarios caian en la regla general 'text=auto' y solo se libraban de la
# conversion de finales de linea por la heuristica del NUL en los primeros 8 KB,
# que depende del contenido y no de lo que aqui se declare.
*.obj  binary
*.bgi  binary
*.chr  binary
*.hlp  binary
*.fnt  binary
*.rzg  binary
*.dat  binary
*.zip  binary
*.OBJ  binary
*.BGI  binary
*.CHR  binary
*.HLP  binary
*.FNT  binary
*.RZG  binary
*.DAT  binary
*.ZIP  binary
# VPA.MSG son plantillas de texto: el port FPC/Linux necesita LF
# (un CRLF deja un CR colgante que RTrim no elimina y corrompe el parseo)
*.msg  text eol=lf
*.MSG  text eol=lf
